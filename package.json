{
  "name": "copilot-testing-workshop",
  "version": "1.0.0",
  "description": "GenAI in Testing: Using GitHub Copilot to Accelerate Quality Without Losing Trust — WeAreDevelopers Berlin 2026",
  "scripts": {
    "dev": "docusaurus start --host 0.0.0.0 --port 3005 --no-open",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3005",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "dev:docker": "concurrently -n docs,api,web -c blue,green,magenta \"npm:dev\" \"npm --prefix workshop-exercises run dev:api\" \"npm --prefix workshop-exercises run dev:web\""
  },
  "keywords": [
    "github-copilot",
    "genai",
    "testing",
    "workshop",
    "wearedevelopers"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
